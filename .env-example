# Kopiera denna fil till ".env" och fyll i dina egna värden.
# Filen .env ska ALDRIG delas eller checkas in i git.

# --- Gratistjänster på nätet (standard) ---
# Räcker gott för några predikningar i veckan. Nycklarna är gratis:
#   Groq (transkribering):  https://console.groq.com/keys
#   Gemini (texter):        https://aistudio.google.com/apikey
# OBS: på Googles gratisnivå får Google använda det som skickas för att
# förbättra sina tjänster.
GROQ_API_KEY=
GEMINI_API_KEY=
# Valfritt: andra modeller. Tomt = whisper-large-v3 resp. gemini-3.8-flash.
GROQ_TRANSCRIPTION_MODEL=
GEMINI_MODEL=
# true = gör jobbet lokalt om tjänsten på nätet inte svarar (t.ex. slut på
# gratiskvoten) - kräver lokal Whisper (transkribering) resp. Ollama (texter).
LOCAL_FALLBACK=false

# --- OpenAI (kostar - används bara om du väljer openai nedan) ---
OPENAI_API_KEY=

# --- Transkribering ---
# Ljudet transkriberas i block om ca 10 minuter, delade i pauser i talet.
#   groq   = Groqs Whisper large-v3 på nätet (gratis, kräver GROQ_API_KEY)
#   local  = på den här datorn, helt offline, med motorn i LOCAL_ASR_ENGINE
#   openai = OpenAI Whisper API (kostar, kräver OPENAI_API_KEY)
# (Ersätter den äldre USE_LOCAL_WHISPER, som fortfarande läses om
# TRANSCRIPTION_PROVIDER saknas.)
TRANSCRIPTION_PROVIDER=groq

# Lokal motor (när TRANSCRIPTION_PROVIDER=local):
#   whisper    = Whisper-modellen i LOCAL_WHISPER_MODEL
#   pianissimo = Klangs svenska taligenkänning Pianissimo
#                (kräver: pip install "onnx-asr[cpu,hub]"; modellen, ca
#                920 MB, laddas ner automatiskt första gången)
LOCAL_ASR_ENGINE=whisper

# Whisper-modell. Svenska KB-Whisper från Kungliga biblioteket gör ungefär
# fyra gånger färre fel på svenska än OpenAI:s modeller - kräver
# faster-whisper (pip install faster-whisper):
#   KBLab/kb-whisper-small (rekommenderas), KBLab/kb-whisper-medium,
#   KBLab/kb-whisper-large
# OpenAI:s flerspråkiga modeller: tiny, base, small, medium, large
LOCAL_WHISPER_MODEL=medium

# Valfritt: annat Hugging Face-förråd eller en lokal mapp med Pianissimos
# ONNX-filer. Tomt = moonhouse/pianissimo-sv-onnx.
PIANISSIMO_MODEL=

# --- AI-berikning (titel/beskrivning/taggar) ---
# "gemini" = Google Gemini på nätet (gratis, kräver GEMINI_API_KEY)
# "openai" = GPT via OpenAI API (kostar, kräver OPENAI_API_KEY)
# "ollama" = lokal modell via Ollama - helt offline, ingen nyckel behövs
#            (kräver: https://ollama.com installerat + "ollama pull llama3.1")
AI_PROVIDER=gemini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Temperatur för AI-anropen, 0-1. Lågt (standard 0.2) ger trognare och mer
# förutsägbara sammanfattningar; högre ger mer varierade formuleringar.
AI_TEMPERATURE=0.2

# Ollamas kontextfönster i tokens - hur mycket text modellen kan läsa åt
# gången. Ollamas eget standardvärde är för litet för en hel predikan (då
# klipps början av prompten tyst bort). 16384 räcker för ca 40 000 tecken
# transkript. Större värde kräver mer minne.
OLLAMA_NUM_CTX=16384

# Valfritt: egna prompter för titel och beskrivning. Tomt = appens inbyggda
# standardprompt. Enklast att redigera under fliken ⚙️ Inställningar, som
# också visar standardprompten att utgå från. Platshållare: {speaker},
# {transcript} (måste finnas med) och, för beskrivningen, {fallback_text}.
# Radbrytningar skrivs som \n inom citattecken, t.ex.
# AI_TITLE_PROMPT="Skriv en titel för predikan av {speaker}.\n\n{transcript}"
AI_TITLE_PROMPT=
AI_DESCRIPTION_PROMPT=

# Valfritt: justera procentmätarens tidsuppskattning för transkribering
# (sekunder bearbetning per sekund ljud). Standard är 1.8 för lokal Whisper
# och 0.2 för OpenAI Whisper API. Höj värdet om mätaren ofta fastnar länge
# på 95% på din dator (den fastnar inte på riktigt - jobbet pågår - men
# gissningen om hur lång tid det tar stämde inte).
WHISPER_TIME_FACTOR=

# --- Spreaker ---
# Skapa en OAuth-token här: https://developers.spreaker.com/
SPREAKER_API_TOKEN=
SPREAKER_SHOW_ID=
# Sätt till "true" för att simulera publicering utan att faktiskt anropa Spreaker
# (praktiskt om du saknar API-nycklar eller bara testar flödet)
SPREAKER_SIMULATE=true

# --- E-post (bekräftelse när avsnittet är publicerat) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=din.epost@gmail.com
SMTP_PASSWORD=app-losenord
# En eller flera mottagare, åtskilda med kommatecken.
NOTIFY_EMAIL=mottagare@exempel.se
# Om SMTP inte är konfigurerat visas endast en sammanfattningssida i webbläsaren.
EMAIL_ENABLED=false

# --- Övrigt ---
# Mapp där uppladdade och klippta filer sparas lokalt
UPLOAD_DIR=uploads
PROCESSED_DIR=processed

# Mapp där ljudfiler för CSV-bulkimport ska läggas innan import (se README).
BULK_IMPORT_DIR=bulk_import

# Mapp för det lokala podd-arkivet (⚙️ Inställningar → 🗄️ Podd-arkiv):
# mp3 + xml + txt per avsnitt och en logg.txt.
# Kan ligga på en annan disk, t.ex. ARCHIVE_DIR=D:/Podcastarkiv
# (relativ sökväg = räknas från projektmappen).
ARCHIVE_DIR=podcast_arkiv

# Automatisk arkivering: off (standard), daily eller weekly. För weekly
# anger ARCHIVE_SCHEDULE_DAY veckodagen: 0 = måndag ... 6 = söndag.
# ARCHIVE_SCHEDULE_TIME är klockslaget (HH:MM). Appen måste vara igång då.
ARCHIVE_SCHEDULE=off
ARCHIVE_SCHEDULE_DAY=6
ARCHIVE_SCHEDULE_TIME=03:00

# Max antal predikningar (episoder) som sparas i UPLOAD_DIR + PROCESSED_DIR
# samtidigt. Äldst tas bort automatiskt efter varje lyckad bearbetning så
# att mapparna inte växer oändligt vid drift över lång tid.
# Tomt/0 (standard) = ingen begränsning.
MAX_STORED_EPISODES=

# Största tillåtna filuppladdning (MB). Skydd mot att en jättefil fyller
# disken. Standard 4000 - räcker för en predikan på 2 timmar i wav
# (1,3-2,1 GB beroende på kvalitet). 0 = ingen gräns.
MAX_UPLOAD_MB=4000

# Inställningsguiden (fliken ⚙️ Inställningar) skriver .env och sköter OAuth
# utan autentisering, så den är som standard BARA tillgänglig lokalt
# (127.0.0.1). Sätt true bara om du kör bakom en autentiserad omvänd proxy,
# eller i Docker (där docker-compose.yml redan sätter den åt dig).
SETUP_ALLOW_REMOTE=false

# --- Loggning ---
# Loggnivå för app.log. Giltiga värden: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
# Valfritt: byt namn/sökväg på loggfilen.
LOG_FILE=app.log

# --- Databas ---
# SQLite-fil där bearbetningskön och episodhistoriken/statistiken sparas
# (se README, avsnitt om databasen). Valfritt: byt namn/sökväg.
DATABASE_FILE=predikan.db
